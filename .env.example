# LexiCore runtime configuration
GEMINI_API_KEY=
LEXICORE_AI_PROVIDER=gemini
LEXICORE_AI_MODEL=gemini-2.5-flash
LEXICORE_AI_CHUNK_SIZE=10000
LEXICORE_AI_CHUNK_OVERLAP=700
LEXICORE_AI_MAX_CHUNKS=24
LEXICORE_AI_CONCURRENCY=2
LEXICORE_AI_TIMEOUT_SECONDS=35

# Database & automatic backup
LEXICORE_DB_PATH=lexicore.db
LEXICORE_BACKUP_DIR=backups
LEXICORE_BACKUP_KEEP=30
LEXICORE_AUTO_BACKUP_DAILY=1
# Tests set this to 1 automatically so throwaway DBs do not create backups.
LEXICORE_DISABLE_AUTO_BACKUP=0

# Server / network
# Defaults: localhost only, debug off. There is no authentication layer yet.
LEXICORE_DEBUG=0
LEXICORE_HOST=127.0.0.1
LEXICORE_PORT=5000
LEXICORE_ALLOW_NETWORK_EXPOSURE=
