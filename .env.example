LEXICORE_AI_PROVIDER=local
LEXICORE_AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
LEXICORE_AI_CHUNK_SIZE=10000
LEXICORE_AI_CHUNK_OVERLAP=700
LEXICORE_AI_MAX_CHUNKS=24
LEXICORE_AI_CONCURRENCY=2
LEXICORE_AI_TIMEOUT_SECONDS=35
LEXICORE_AI_RETRIES=2
LEXICORE_DB_PATH=lexicore.db
LEXICORE_BACKUP_DIR=backups
LEXICORE_BACKUP_KEEP=30
LEXICORE_AUTO_BACKUP_DAILY=1
LEXICORE_DEBUG=0
LEXICORE_HOST=127.0.0.1
LEXICORE_PORT=5000
LEXICORE_OCR_LANG=ind+eng
LEXICORE_OCR_DPI=220
LEXICORE_OCR_TIMEOUT_SECONDS=45
LEXICORE_OCR_MAX_IMAGE_DIM=4200

# Embedded portable OCR (no OS-level Tesseract required)
LEXICORE_OCR_ENGINE=embedded_rapidocr
LEXICORE_OCR_MIN_CONFIDENCE=0.45
LEXICORE_OCR_ALLOW_TESSERACT_FALLBACK=1

# RC18 OCR runtime recovery: adaptive engine budgets + monotonic coverage guard.
LEXICORE_OCR_TOTAL_TIMEOUT_SECONDS=180
LEXICORE_OCR_FAST_DPI=170
LEXICORE_RAPIDOCR_MIN_TIMEOUT_SECONDS=8
LEXICORE_RAPIDOCR_MAX_TIMEOUT_SECONDS=12
LEXICORE_RAPIDOCR_CIRCUIT_FAILURES=3
LEXICORE_RAPIDOCR_CIRCUIT_COOLDOWN_SECONDS=30
LEXICORE_TESSERACT_MIN_TIMEOUT_SECONDS=12
LEXICORE_TESSERACT_MAX_TIMEOUT_SECONDS=20
# Optional explicit cap; leave empty to use adaptive 12-20s policy.
LEXICORE_TESSERACT_PAGE_TIMEOUT_SECONDS=
LEXICORE_OCR_BUDGET_RESERVE_SECONDS=8
LEXICORE_OCR_MIN_ACCEPTABLE_COVERAGE=0.80
# Below 20% coverage, OCR text is diagnostic-only and Case Analysis is blocked.
LEXICORE_OCR_SEVERE_COVERAGE_FLOOR=0.20

# Diagnostic only. Disabled by default; does not change OCR decision logic.
LEXICORE_OCR_DEBUG=0
LEXICORE_OCR_DEBUG_FILE=ocr_debug.jsonl

# Commercial desktop license gate (desktop_launcher enables required=1 automatically)
LEXICORE_LICENSE_REQUIRED=0
LEXICORE_LICENSE_SERVER_URL=
# Public verification key only. Never place the private signing key in the desktop app.
LEXICORE_LICENSE_PUBLIC_KEY_FILE=license_public_key.pem
